{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sovereign-mail-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sovereign-mail-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MAIL_OBJECTS", "bucket_name": "sovereign-mail-test-mail" }],
  "queues": {
    "producers": [{ "binding": "SOVEREIGN_MAIL_JOBS", "queue": "sovereign-mail-test-jobs" }],
    "consumers": [
      {
        "queue": "sovereign-mail-test-jobs",
        "dead_letter_queue": "sovereign-mail-test-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "send_email": [{ "name": "MAIL_SENDER" }]
}
