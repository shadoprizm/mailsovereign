# Sovereign Mail generates authentication, provider-encryption, and Web Push secrets during installation.
# Add local-only values to `.dev.vars`; never commit secret values.
# BETTER_AUTH_SECRET=generate-a-local-secret
# PROVIDER_CREDENTIAL_KEY=generate-exactly-32-base64-bytes
# SOVEREIGN_MAIL_LOCAL_SEED_PASSWORD=use-a-local-password-at-least-8-characters
